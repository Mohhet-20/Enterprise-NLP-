# Copy to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=development

# --- Security ---
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database ---
DATABASE_URL=sqlite:///./nlp_platform.db

# --- Redis (cache/rate-limit backend; falls back to in-memory automatically
# if unreachable — see backend/core/cache.py) ---
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3000"]
